diff --git a/DemoAspireApp.TaskApi/Program.cs b/DemoAspireApp.TaskApi/Program.cs
new file mode 100644
index 0000000..f0389d5
--- /dev/null
+++ b/DemoAspireApp.TaskApi/Program.cs
@@ -0,0 +1,41 @@
+var builder = WebApplication.CreateBuilder(args);
+
+// Add services to the container.
+// Learn more about configuring OpenAPI at https://aka.ms/aspnet/openapi
+builder.Services.AddOpenApi();
+
+builder.AddServiceDefaults();
+
+var app = builder.Build();
+
+// Configure the HTTP request pipeline.
+if (app.Environment.IsDevelopment())
+{
+    app.MapOpenApi();
+}
+
+app.UseHttpsRedirection();
+
+var summaries = new[]
+{
+    "Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering", "Scorching"
+};
+
+app.MapGet("/tasks", () =>
+{
+    var tasks =  Enumerable.Range(1, 5).Select(index =>
+        new TodoTask
+        (
+            $"Task {index}",
+            DateOnly.FromDateTime(DateTime.Now.AddDays(index))
+        ))
+        .ToArray();
+    return tasks;
+})
+.WithName("GetTasks");
+
+app.MapDefaultEndpoints();
+
+app.Run();
+
+public record TodoTask(string Description, DateOnly Deadline);
